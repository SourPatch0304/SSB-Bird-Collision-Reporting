generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "sqlite"
url      = env("DATABASE_URL")
}

model reports {
report_id            String   @id
sender_hash          String
thread_id            String
status               String?  @default("new")
observed_at          String?
message_receipt_time String
exif_capture_time    String?
time_source          String?
created_at           String?  @default(dbgenerated("CURRENT_TIMESTAMP"))

chatbot_interactions chatbot_interactions[]
followup_answers     followup_answers[]
images               images[]
}

model images {
image_id      String   @id
report_id     String
file_path     String
file_size     Int?
file_type     String?
upload_order  Int?
created_at    String?  @default(dbgenerated("CURRENT_TIMESTAMP"))

reports         reports           @relation(fields: [report_id], references: [report_id], onDelete: NoAction, onUpdate: NoAction)
exif_data       exif_data?
vision_analysis vision_analysis[]
}

model exif_data {
image_id       String   @id
gps_latitude   Float?
gps_longitude  Float?
gps_accuracy_m Float?
geohash        String?
device_make    String?
device_model   String?
orientation    Int?
capture_time   String?
all_exif_data  String?

images         images   @relation(fields: [image_id], references: [image_id], onDelete: NoAction, onUpdate: NoAction)
}

model chatbot_interactions {
interaction_id   String   @id
report_id        String
interaction_type String?
message_text     String?
is_from_user     Boolean? @default(false)
created_at       String?  @default(dbgenerated("CURRENT_TIMESTAMP"))

reports          reports  @relation(fields: [report_id], references: [report_id], onDelete: NoAction, onUpdate: NoAction)
}

model vision_analysis {
analysis_id            String   @id
image_id               String
taxon_hint             String?
confidence_score       Float?
glass_context_detected Boolean?
quality_issues         String?
analysis_data          String?

created_at             String?  @default(dbgenerated("CURRENT_TIMESTAMP"))

images                 images   @relation(fields: [image_id], references: [image_id], onDelete: NoAction, onUpdate: NoAction)
}

model followup_answers {
answer_id        String   @id
report_id        String
question_type    String?
answer_text      String?
geocoded_address String?
geocoded_lat     Float?
geocoded_lng     Float?
created_at       String?  @default(dbgenerated("CURRENT_TIMESTAMP"))

reports          reports  @relation(fields: [report_id], references: [report_id], onDelete: NoAction, onUpdate: NoAction)
}

model audit_log {
log_id     String   @id
report_id  String?
action     String
details    String?

created_at String?  @default(dbgenerated("CURRENT_TIMESTAMP"))
}